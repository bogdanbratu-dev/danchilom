# Copiază fișierul acesta în `.env.local` și completează valorile.
# Fără ele site-ul funcționează normal, doar că formularul de înscriere
# afișează varianta de rezervă: telefon și WhatsApp.

# Cheia de API de la https://resend.com (plan gratuit: 3.000 emailuri/lună)
RESEND_API_KEY=

# Adresa pe care ajung cererile de înscriere
CONTACT_TO_EMAIL=asdanchilom@yahoo.com

# Expeditorul emailurilor. Până la verificarea domeniului în Resend,
# lasă valoarea implicită `onboarding@resend.dev`.
# După verificare, folosește ceva de forma: AS Dan Chilom <site@danchilom.ro>
CONTACT_FROM_EMAIL=

# Parola panoului de administrare (/admin) — alege una simplu de reținut și
# transmite-o doar persoanei care va edita site-ul. Fără ea, /admin e dezactivat.
ADMIN_PASSWORD=

# Token de la un Vercel Blob store (Storage → Create Database → Blob, în
# dashboard-ul Vercel). Necesar ca textele și pozele schimbate din /admin să
# rămână salvate definitiv, inclusiv după o publicare nouă a site-ului. Fără
# el, modificările din admin se salvează doar local, pe acest calculator.
BLOB_READ_WRITE_TOKEN=

# ID-ul de măsurare Google Analytics (Admin → Fluxuri de date → flux Web, în
# analytics.google.com), format G-XXXXXXXXXX. Fără el, nu se trimite trafic
# către Analytics. Vizitele persoanei logate în /admin nu sunt niciodată
# trimise, indiferent de valoarea asta.
GA_MEASUREMENT_ID=
